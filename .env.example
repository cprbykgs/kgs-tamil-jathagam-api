# Comma-separated list of browser origins allowed to call this API. No spaces, no trailing slash.
# Put your Lovable preview URL and your final domain here.
ALLOWED_ORIGINS=https://your-project.lovable.app,https://jathagam.yourdomain.in
# Port inside the container (leave as is)
PORT=8000
# Folder with Swiss Ephemeris .se1 files (leave as is)
EPHE_DIR=/srv/ephe
# Folder where daily ராசி பலன் drafts/approvals are stored (mounted from ./data in docker-compose)
DATA_DIR=/srv/data
# Secret for the admin preview/approve endpoints. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-to-a-long-random-string
